{
  "functions": {
    "source": "functions",
    "runtime": "nodejs18"
  },
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/zegoToken", "function": "zegoToken" },
      { "source": "/api/agoraToken", "function": "agoraToken" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
